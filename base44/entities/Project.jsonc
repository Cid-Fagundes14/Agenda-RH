{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "notes": {
      "type": "string",
      "title": "Anota\u00e7\u00f5es"
    },
    "color": {
      "type": "string",
      "title": "Cor",
      "default": "#2563EB"
    },
    "event_type": {
      "type": "string",
      "title": "Data do evento",
      "enum": [
        "none",
        "day",
        "range"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ],
      "default": "none"
    },
    "event_date": {
      "type": "string",
      "title": "Data do evento"
    },
    "event_start": {
      "type": "string",
      "title": "In\u00edcio do evento"
    },
    "event_end": {
      "type": "string",
      "title": "Fim do evento"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
